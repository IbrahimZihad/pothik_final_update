# Copy to frontend/.env. Vite only exposes VITE_* variables to the browser.

# Base URL of the API. Use /api/v1 when Nginx proxies /api to the backend.
VITE_API_URL=/api/v1

# Public origin of the site. Used at build time for canonical and Open Graph URLs
# in index.html, so link previews point at the real domain. No trailing slash.
VITE_SITE_URL=http://localhost:5173
