# POTHIK backend environment template.
# Copy to backend/.env and fill in real values. Never commit .env.
# All values below are placeholders, not credentials.

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_URL=http://localhost:5173
API_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173

# --- Database -------------------------------------------------------------
# mysql for real deployments; sqlite is for local development and tests only.
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pothik_dev
DB_USER=pothik_app
DB_PASSWORD=change-me
DB_LOGGING=false
DB_POOL_MAX=10

# SQLite only (DB_DIALECT=sqlite):
# SQLITE_STORAGE=tmp/dev.sqlite

# --- Auth -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production requires at least 32 characters; use different values per secret.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- Redis / jobs ---------------------------------------------------------
# Leave REDIS_URL empty to run jobs inline and cache in process memory.
REDIS_URL=
QUEUE_ENABLED=false

# --- Payments -------------------------------------------------------------
# demo is allowed only outside production. Production refuses to boot with demo.
# Allowed gateways: demo, sslcommerz, bkash.
PAYMENT_GATEWAY=demo
PAYMENT_CALLBACK_SECRET=replace-with-a-random-callback-secret
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# bKash Tokenized Checkout sandbox credentials from the bKash developer portal.
# Leave BKASH_BASE_URL empty to use the sandbox/production URL implied by BKASH_SANDBOX.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true
BKASH_BASE_URL=

# --- Commission defaults (%) ---------------------------------------------
PLATFORM_COMMISSION_RATE=10
HOTEL_COMMISSION_RATE=12
TRANSPORT_COMMISSION_RATE=10
GUIDE_COMMISSION_RATE=10

# --- Admin bootstrap (used by the admin seeder, not hardcoded anywhere) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Platform Administrator

# --- Uploads, rate limits, hashing ---------------------------------------
# Leave UPLOAD_DIR unset to use backend/uploads. An empty value breaks startup.
# UPLOAD_DIR=
MAX_UPLOAD_MB=5
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
BCRYPT_ROUNDS=12

# Password for seeded demo accounts. Leave empty to use the documented demo
# default; set a strong value for any shared environment.
SEED_DEMO_PASSWORD=
