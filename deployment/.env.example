# Copy to deployment/.env and replace every placeholder.
# This file is read by docker compose (deployment/docker-compose.yml).
# Never commit deployment/.env.

# ------------------------------------------------------------------ runtime
NODE_ENV=production
# Exact public origin. Drives CORS, payment return URLs and the canonical/OG URLs
# baked into the frontend build, so rebuild the frontend if it changes.
PUBLIC_URL=https://pothik.example.com
HTTP_PORT=80

# ------------------------------------------------------------------- MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=pothik
MYSQL_USER=pothik_app
MYSQL_PASSWORD=change-me-app
MYSQL_MAX_CONNECTIONS=300

# -------------------------------------------------------------- API secrets
# Generate with: openssl rand -hex 32   (use different values for each key)
JWT_ACCESS_SECRET=replace-with-64-hex-characters
JWT_REFRESH_SECRET=replace-with-a-different-64-hex-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
PAYMENT_CALLBACK_SECRET=replace-with-a-long-random-value

DB_POOL_MAX=10
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
BCRYPT_ROUNDS=12
MAX_UPLOAD_MB=5

# ---------------------------------------------------------------- payments
# `demo` is rejected in production by src/config/index.js.
# Allowed gateways: demo, sslcommerz, bkash.
PAYMENT_GATEWAY=sslcommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# bKash Tokenized Checkout credentials (developer portal -> sandbox/production).
# BKASH_BASE_URL is optional; leave empty to use the URL implied by BKASH_SANDBOX.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true
BKASH_BASE_URL=

# -------------------------------------------------------------- commissions
PLATFORM_COMMISSION_RATE=10
HOTEL_COMMISSION_RATE=12
TRANSPORT_COMMISSION_RATE=10
GUIDE_COMMISSION_RATE=10

# ------------------------------------------------------------------- admin
# Used by the admin seeder. Leave ADMIN_PASSWORD empty to skip creating the
# bootstrap administrator until you set it deliberately.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Platform Administrator

# Optional: password for seeded demo accounts. Leave empty in production.
SEED_DEMO_PASSWORD=
